<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">사업 개요</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">본 사업은 </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">중소기업 </w:t></w:r><w:r><w:t xml:space="preserve">지원을 위한 </w:t></w:r><w:r><w:rPr><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">시범 사업</w:t></w:r><w:r><w:t xml:space="preserve">이며, </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">신청 마감</w:t></w:r><w:r><w:t xml:space="preserve">은 </w:t></w:r><w:r><w:rPr><w:strike/></w:rPr><w:t xml:space="preserve">9월 30일</w:t></w:r><w:r><w:t xml:space="preserve"> 10월 15일입니다.</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">첫째 줄</w:t><w:br/><w:t xml:space="preserve">둘째 줄</w:t><w:tab/><w:t xml:space="preserve">탭 뒤 고정폭     연속 공백</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">특수 문자</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve"># 해시로 시작하는 줄</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">&gt; 꺾쇠로 시작하는 줄</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">---</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">기간: 10~20일 (물결 하나는 그대로)</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">범위 1~2 및 3~4 (물결 둘 이상은 이스케이프)</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">성명: ________ (서명란 밑줄), 변수_이름, *별표*, `백틱`, C:\경로</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">&lt;기업명&gt; 그대로, &lt;b&gt;태그&lt;/b&gt;는 이스케이프, [붙임](1) 링크 방지, [참고] 그대로</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t xml:space="preserve">- 직접 입력한 글머리표</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/><w:pageBreakBefore/></w:pPr><w:r><w:t xml:space="preserve">개체와 컨트롤</w:t></w:r></w:p>
