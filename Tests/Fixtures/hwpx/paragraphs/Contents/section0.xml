<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<hs:sec xmlns:hs="http://www.hancom.co.kr/hwpml/2011/section" xmlns:hp="http://www.hancom.co.kr/hwpml/2011/paragraph" xmlns:hc="http://www.hancom.co.kr/hwpml/2011/core">
  <!-- 구역 설정이 든 첫 문단 (secPr 안의 텍스트 없음) -->
  <hp:p id="0" paraPrIDRef="1" styleIDRef="1" pageBreak="0" columnBreak="0" merged="0">
    <hp:run charPrIDRef="0">
      <hp:secPr id="" textDirection="HORIZONTAL"><hp:pagePr landscape="WIDELY" width="59528" height="84186"/></hp:secPr>
      <hp:ctrl><hp:colPr id="" type="NEWSPAPER" colCount="1"/></hp:ctrl>
    </hp:run>
    <hp:run charPrIDRef="1"><hp:t>사업 개요</hp:t></hp:run>
    <hp:linesegarray><hp:lineseg textpos="0" vertpos="0"/></hp:linesegarray>
  </hp:p>

  <!-- 강조: 굵게 / 기울임 / 굵게+밑줄 / 취소선, 앞뒤 공백은 강조 바깥으로 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0"><hp:t>본 사업은 </hp:t></hp:run>
    <hp:run charPrIDRef="1"><hp:t>중소기업 </hp:t></hp:run>
    <hp:run charPrIDRef="0"><hp:t>지원을 위한 </hp:t></hp:run>
    <hp:run charPrIDRef="2"><hp:t>시범 사업</hp:t></hp:run>
    <hp:run charPrIDRef="0"><hp:t>이며, </hp:t></hp:run>
    <hp:run charPrIDRef="3"><hp:t>신청 마감</hp:t></hp:run>
    <hp:run charPrIDRef="0"><hp:t>은 </hp:t></hp:run>
    <hp:run charPrIDRef="4"><hp:t>9월 30일</hp:t></hp:run>
    <hp:run charPrIDRef="0"><hp:t> 10월 15일입니다.</hp:t></hp:run>
  </hp:p>

  <!-- 줄바꿈·탭·고정폭 빈칸, 연속 공백 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0"><hp:t>첫째 줄<hp:lineBreak/>둘째 줄<hp:tab width="4000" leader="0" type="1"/>탭 뒤<hp:fwSpace/>고정폭     연속 공백</hp:t></hp:run>
  </hp:p>

  <!-- 빈 문단, 공백뿐인 문단은 출력하지 않는다 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"/></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="1"><hp:t>   </hp:t></hp:run></hp:p>

  <hp:p id="0" paraPrIDRef="2" styleIDRef="2">
    <hp:run charPrIDRef="0"><hp:t>특수 문자</hp:t></hp:run>
  </hp:p>

  <!-- Markdown 문법으로 오인될 수 있는 텍스트 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t># 해시로 시작하는 줄</hp:t></hp:run></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>&gt; 꺾쇠로 시작하는 줄</hp:t></hp:run></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>---</hp:t></hp:run></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>기간: 10~20일 (물결 하나는 그대로)</hp:t></hp:run></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>범위 1~2 및 3~4 (물결 둘 이상은 이스케이프)</hp:t></hp:run></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>성명: ________ (서명란 밑줄), 변수_이름, *별표*, `백틱`, C:\경로</hp:t></hp:run></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>&lt;기업명&gt; 그대로, &lt;b&gt;태그&lt;/b&gt;는 이스케이프, [붙임](1) 링크 방지, [참고] 그대로</hp:t></hp:run></hp:p>
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>- 직접 입력한 글머리표</hp:t></hp:run></hp:p>

  <!-- 쪽 나눔: Markdown에는 나오지 않음 -->
  <hp:p id="0" paraPrIDRef="2" styleIDRef="2" pageBreak="1">
    <hp:run charPrIDRef="0"><hp:t>개체와 컨트롤</hp:t></hp:run>
  </hp:p>

  <!-- 양식 개체 (체크박스) -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0">
      <hp:checkBtn caption="" value="CHECKED" name="CheckBox1"><hp:formCharPr charPrIDRef="0"/></hp:checkBtn>
      <hp:t> 동의함 </hp:t>
      <hp:checkBtn caption="" value="UNCHECKED" name="CheckBox2"><hp:formCharPr charPrIDRef="0"/></hp:checkBtn>
      <hp:t> 동의하지 않음</hp:t>
    </hp:run>
  </hp:p>

  <!-- 계산식 필드: 매개변수 문자열은 본문이 아니고, 표시값만 hp:t에 있다 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0">
      <hp:t>합계: </hp:t>
      <hp:ctrl>
        <hp:fieldBegin id="1" type="FORMULA" name="" editable="0" dirty="0">
          <hp:parameters cnt="2" name="">
            <hp:stringParam name="Command">=SUM(?1:?3)??%g,;;1,000,000</hp:stringParam>
            <hp:stringParam name="LastResult">1,000,000</hp:stringParam>
          </hp:parameters>
        </hp:fieldBegin>
      </hp:ctrl>
      <hp:t>1,000,000</hp:t>
      <hp:ctrl><hp:fieldEnd beginIDRef="1"/></hp:ctrl>
      <hp:t>원</hp:t>
    </hp:run>
  </hp:p>

  <!-- 호환용 이중 표기: hp:default는 건너뛴다 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0">
      <hp:switch>
        <hp:case hp:required-namespace="http://www.hancom.co.kr/hwpml/2016/paragraph"><hp:t>신형 표기 본문</hp:t></hp:case>
        <hp:default><hp:t>신형 표기 본문</hp:t></hp:default>
      </hp:switch>
    </hp:run>
  </hp:p>

  <!-- 수식: 스크립트를 raw로 보존 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0">
      <hp:t>수익률 공식:</hp:t>
      <hp:equation id="5" version="Equation Version 60" baseLine="85"><hp:sz width="3000" height="2000"/><hp:script>r = {P _{1} - P _{0}} over {P _{0}}</hp:script></hp:equation>
    </hp:run>
  </hp:p>

  <!-- 각주: 문단 뒤에 붙인다 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0">
      <hp:t>지원 대상은 예비창업자입니다</hp:t>
      <hp:ctrl>
        <hp:footNote number="1" instId="11">
          <hp:subList id="" textDirection="HORIZONTAL">
            <hp:p id="0" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>사업자 등록 전인 사람</hp:t></hp:run></hp:p>
          </hp:subList>
        </hp:footNote>
      </hp:ctrl>
      <hp:t>.</hp:t>
    </hp:run>
  </hp:p>

  <!-- 글상자: 도형 안 텍스트만 추출 -->
  <hp:p id="0" paraPrIDRef="0" styleIDRef="0">
    <hp:run charPrIDRef="0">
      <hp:rect id="7" zOrder="1" numberingType="FIGURE">
        <hp:shapeComment>사각형입니다.</hp:shapeComment>
        <hp:drawText lastWidth="10000" name="" editable="0">
          <hp:subList id="" textDirection="HORIZONTAL">
            <hp:p id="0" paraPrIDRef="6" styleIDRef="0"><hp:run charPrIDRef="1"><hp:t>글상자 안 강조 문구</hp:t></hp:run></hp:p>
          </hp:subList>
        </hp:drawText>
      </hp:rect>
    </hp:run>
  </hp:p>
</hs:sec>
